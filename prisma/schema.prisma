// Prisma schema for Ariana Gems & Jewellery
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id
  name        String
  latin       String
  category    String
  price       Int
  compareAt   Int?
  description  String
  surface     String   @default("gold")
  image       String
  tags        String[] @default([])
  bestSeller  Boolean  @default(false)
  newArrival  Boolean  @default(false)
  rating      Float    @default(5)
  reviews     Int      @default(0)
  // Admin-controlled gold specs. Empty/null → the product page shows N/A.
  karats      String[] @default([])
  goldWeight  Float?
  totalWeight Float?
  createdAt   DateTime @default(now())

  orderItems  OrderItem[]

  @@index([category])
}

model Customer {
  id     String   @id
  name   String
  email  String
  orders Int      @default(0)
  spent  Int      @default(0)
  joined String
}

model Order {
  id         String      @id
  customer   String
  email      String
  total      Int
  status     String      @default("paid")
  date       String
  items      Int         @default(0)
  couponCode String?
  discount   Int         @default(0)
  /// The account that placed the order (null for guest checkout) — lets
  /// "My Orders" show only the signed-in customer's own history.
  userId     String?
  createdAt  DateTime    @default(now())

  lines      OrderItem[]

  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Int
  quantity  Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  salt      String
  hash      String
  role      String   @default("customer")
  createdAt DateTime @default(now())
  /// Base32 TOTP secret. Set (but not yet trusted) as soon as setup begins;
  /// only twoFactorEnabled gates login — see lib/totp.ts / lib/db.ts.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean  @default(false)
  /// Each entry "<saltHex>:<scryptHex>" — single-use, removed on redemption.
  twoFactorBackupCodes String[] @default([])
  /// Last accepted TOTP step (replay guard — see lib/totp.ts verifyTotp).
  twoFactorLastStep    Int?

  sessions  Session[]
  twoFactorPending TwoFactorPending[]
  passwordResetTokens PasswordResetToken[]
}

model Session {
  token     String    @id
  userId    String
  createdAt DateTime  @default(now())
  /// Absolute expiry. A session is rejected (and cleaned up) once past this.
  expiresAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A short-lived challenge issued after a correct password when the account
/// has 2FA enabled — proves "password was correct, awaiting a code," never
/// grants access on its own, and is never confused with (or replayable as)
/// a real Session token even if logged or leaked.
model TwoFactorPending {
  token     String   @id
  userId    String
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use, short-lived password-reset challenge for a User (customer or
/// admin — distinguished only by the owning User's role, same as everywhere
/// else in this schema). Only a SHA-256 hash of the raw token is ever
/// stored; the raw token exists solely in the emailed link. `usedAt` marks
/// it permanently spent so it cannot be replayed even before `expiresAt`.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Newsletter {
  email     String   @id
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Coupon {
  code         String    @id
  description  String
  discountType String    @default("percent") // "percent" | "fixed"
  value        Int // percent (1-100) or fixed AUD amount, per discountType
  minSubtotal  Int       @default(0)
  maxUses      Int? // null = unlimited
  usedCount    Int       @default(0)
  active       Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  buttonText String?
  link       String?
  image      String?
  surface    String   @default("gold") // "gold" | "dark" | "cream" — matches GemSurface
  status     String   @default("active") // "active" | "scheduled" | "inactive"
  createdAt  DateTime @default(now())
}

/// Singleton store configuration row (always id: "default").
model StoreSettings {
  id                    String   @id @default("default")
  storeName             String   @default("Ariana Gems & Jewellery")
  email                 String   @default("hello@ariana.example")
  phone                 String   @default("+61 3 9791 1331")
  currency              String   @default("AUD")
  freeShippingThreshold Int      @default(500)
  taxRatePercent        Float    @default(5)
  notifyNewOrders       Boolean  @default(true)
  notifyLowStock        Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}
