# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://ariana:ariana@127.0.0.1:5432/ariana?schema=public"

# NOTE for hosted Postgres (Neon / Vercel Postgres / Supabase):
# The integration may expose the URL under a different name — the app and the
# build step automatically fall back to any of these if DATABASE_URL is unset:
#   POSTGRES_PRISMA_URL, POSTGRES_URL, DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING
# You can just add a plain DATABASE_URL with the connection string and be done.
