# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres.xmgrlezunghgnhvmjmix:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# NOTE for hosted Postgres (Neon / Vercel Postgres / Supabase):
# The integration may expose the URL under a different name — the app and the
# build step automatically fall back to any of these if DATABASE_URL is unset:
#   POSTGRES_PRISMA_URL, POSTGRES_URL, DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING
# You can just add a plain DATABASE_URL with the connection string and be done.
#
# ⚠️ Supabase + Vercel: do NOT use the direct host (db.<ref>.supabase.co:5432)
# — it is IPv6-only, and Vercel builds/functions are IPv4, so every connection
# fails with P1001 "Can't reach database server". Use the Supavisor POOLER
# strings from Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL  = postgresql://postgres.xmgrlezunghgnhvmjmix:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
#   DIRECT_URL    = postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
# (6543 = transaction pooler for the app; 5432 on the pooler host = session
# mode, used by `prisma migrate deploy` at build time.)

# ------------------------------------------------------------------
# Admin bootstrap (no hardcoded credentials).
# On first login the app idempotently creates (or promotes) exactly one
# admin account from these variables. Set them in your host's env — never
# commit real values. Leave unset and NO admin account exists, so the
# admin panel cannot be entered by anyone.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-passphrase"
ADMIN_NAME="Administrator"

# ------------------------------------------------------------------
# Site URL — used to build absolute links in emails (password reset, etc).
# Set this to your real deployed domain in production; without it, reset
# links fall back to a placeholder domain and will not work for users.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ------------------------------------------------------------------
# Transactional email (forgot/reset password). Provider: Resend, called
# over HTTP — no SDK required. Sign up at https://resend.com, verify a
# sending domain, and create an API key.
# Leave unset in development: emails are printed to the server console
# instead of sent, so the reset flow is still testable locally. In
# production, forgot-password requests will fail to deliver (though the
# API still responds normally, to avoid leaking account existence) until
# both variables below are set.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# "Display Name <verified@yourdomain.com>" — the address must be on a
# domain verified with your email provider.
EMAIL_FROM="Ariana Gems & Jewellery <noreply@your-domain.com>"

# ------------------------------------------------------------------
# Image storage (Supabase Storage) — used for product photo (front/left/
# right/back) and banner image uploads in the Admin Panel (lib/storage.ts).
# Get these from Supabase → Project Settings → API. SUPABASE_URL is the
# "Project URL" (e.g. https://xmgrlezunghgnhvmjmix.supabase.co) — the SAME
# project your DATABASE_URL above points at works fine.
#
# SUPABASE_SERVICE_ROLE_KEY is a secret with full read/write access to your
# project — it is used server-side only (never sent to the browser) and
# must never be committed or exposed as a NEXT_PUBLIC_ variable.
#
# Before uploads will work, create a PUBLIC bucket named "store-images" in
# Supabase → Storage. Leave both variables unset and the admin upload UI
# will show a clear "storage not configured" error instead of failing
# silently — nothing else in the app requires them.
SUPABASE_URL="https://xmgrlezunghgnhvmjmix.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
